#!/bin/sh
#
# An example hook script to verify what is about to be committed.
# Called by "git commit" with no arguments.  The hook should
# exit with non-zero status after issuing an appropriate message if
# it wants to stop the commit.
#
# To enable this hook, rename this file to "pre-commit".

if git rev-parse --verify HEAD >/dev/null 2>&1
then
	against=HEAD
else
	# Initial commit: diff against an empty tree object
	against=$(git hash-object -t tree /dev/null)
fi

# If you want to allow non-ASCII filenames set this variable to true.
allownonascii=$(git config --type=bool hooks.allownonascii)

# Redirect output to stderr.
exec 1>&2

# Cross platform projects tend to avoid non-ASCII filenames; prevent
# them from being added to the repository. We exploit the fact that the
# printable range starts at the space character and ends with tilde.
if [ "$allownonascii" != "true" ] &&
	# Note that the use of brackets around a tr range is ok here, (it's
	# even required, for portability to Solaris 10's /usr/bin/tr), since
	# the square bracket bytes happen to fall in the designated range.
	test $(git diff --cached --name-only --diff-filter=A -z $against |
	  LC_ALL=C tr -d '[ -~]\0' | wc -c) != 0
then
	cat <<\EOF
Error: Attempt to add a non-ASCII file name.

This can cause problems if you want to work with people on other platforms.

To be portable it is advisable to rename the file.

If you know what you are doing you can disable this check using:

  git config hooks.allownonascii true
EOF
	exit 1
fi

# If there are whitespace errors, print the offending file names and fail.
#exec git diff-index --check --cached $against --

### Mandatory Rust project checks
# ensure code passes unit tests and integration tests
if ! cargo test 
then
    echo "Some tests are not passing.  Please fix and run 'cargo test' for more information."
    exit 1
fi

# ensure code passes clippy linter
if ! cargo clippy --locked --all-targets --all-features -- -D warnings 
then
    echo "There are some clippy linter issues.  Run 'cargo clippy --locked --all-targets --all-features -- -D warnings' for more information."
    exit 1
fi

# ensure code is properly formatted
if ! cargo fmt -- --check
then
    echo "There are some code formatting or style issues.  Run 'cargo fmt -- --check' for more information."
    exit 1
fi

# documentation builds without issues
if ! cargo doc --locked --no-deps --all-features
then
    echo "There are some documentation build issues.  Run 'cargo doc --locked --no-deps --all-features' for more information."
    exit 1
fi

# security audit dependencies (cargo audit)
if ! cargo audit
then
    echo "Security audit failed or vulnerabilities found in dependencies. Run 'cargo audit' for more information."
    exit 1
fi

# Check Cargo.lock and crates.io for chrono / iroh / netwatch updates
# (ensures RUSTSEC-2026-0543 remains isolated to Windows-only netwatch/wmi and flags upstream fixes)
if command -v python3 >/dev/null 2>&1; then
    if ! python3 - "$(git rev-parse --show-toplevel)/Cargo.lock" <<'PYEOF'
import json
import re
import sys
import urllib.error
import urllib.request

MAX_INDEX_BYTES = 16 * 1024 * 1024
ALLOWED_CHRONO_DEPENDENTS = {"netwatch", "wmi"}

lock_path = sys.argv[1]
try:
    with open(lock_path, "r", encoding="utf-8") as fh:
        lock_text = fh.read()
except OSError as err:
    print(f"Warning: Could not read {lock_path} to check iroh/netwatch versions: {err}", file=sys.stderr)
    sys.exit(0)

pkg_versions = {}
unexpected_chrono_dependents = []
for block in re.split(r"\n\[\[package\]\]\s*\n", lock_text):
    name_m = re.search(r'^name\s*=\s*"([^"]+)"', block, re.MULTILINE)
    ver_m = re.search(r'^version\s*=\s*"([^"]+)"', block, re.MULTILINE)
    if name_m and ver_m:
        pkg_name = name_m.group(1)
        pkg_versions.setdefault(pkg_name, []).append(ver_m.group(1))
        deps_m = re.search(r"^dependencies\s*=\s*\[(.*?)\]", block, re.MULTILINE | re.DOTALL)
        if deps_m and re.search(r'"chrono(?:\s|")', deps_m.group(1)):
            if pkg_name not in ALLOWED_CHRONO_DEPENDENTS:
                unexpected_chrono_dependents.append(f"{pkg_name} {ver_m.group(1)}")

if unexpected_chrono_dependents:
    print(
        "Error: Unexpected packages depend on `chrono` in Cargo.lock: "
        + ", ".join(sorted(set(unexpected_chrono_dependents)))
        + ".\nRUSTSEC-2026-0543 in .cargo/audit.toml is only approved for Windows-only `netwatch` / `wmi`.",
        file=sys.stderr,
    )
    sys.exit(1)

def parse_stable_semver(ver_str):
    core = ver_str.split("+", 1)[0]
    if "-" in core:
        return None
    parts = core.split(".")
    if len(parts) != 3 or not all(p.isdigit() for p in parts):
        return None
    return tuple(int(p) for p in parts)

def fetch_index(index_url, crate_name):
    req = urllib.request.Request(index_url, headers={"User-Agent": "datapipe-pre-commit-hook"})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            raw = resp.read(MAX_INDEX_BYTES + 1)
            if len(raw) > MAX_INDEX_BYTES:
                print(
                    f"Warning: crates.io index response for {crate_name} exceeded {MAX_INDEX_BYTES} bytes; skipping check.",
                    file=sys.stderr,
                )
                return None
            return raw.decode("utf-8").splitlines()
    except (urllib.error.URLError, TimeoutError, OSError, UnicodeDecodeError) as err:
        print(f"Warning: Unable to query crates.io for {crate_name} updates ({err}); skipping check.", file=sys.stderr)
        return None

def tracked_dep_reqs(entry, dep_names):
    reqs = {}
    for dep_name in dep_names:
        matched = sorted(
            {
                f"{d.get('req', '')} [default_features={bool(d.get('default_features', True))}, features={','.join(sorted(d.get('features', [])))}]"
                for d in entry.get("deps", [])
                if d.get("name") == dep_name and d.get("kind", "normal") == "normal"
            }
        )
        reqs[dep_name] = "; ".join(matched) if matched else None
    return reqs

def check_crate_updates(crate_name, index_url, tracked_deps):
    versions = pkg_versions.get(crate_name, [])
    stable_versions = [
        (ver_tuple, ver_str)
        for ver_str in versions
        if (ver_tuple := parse_stable_semver(ver_str)) is not None
    ]
    if not stable_versions:
        return False
    locked_tuple, locked_ver = max(stable_versions)
    lines = fetch_index(index_url, crate_name)
    if lines is None:
        return False

    locked_reqs = None
    newer_candidates = []
    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        if entry.get("yanked"):
            continue
        vers = entry.get("vers", "")
        reqs = tracked_dep_reqs(entry, tracked_deps)
        if vers == locked_ver:
            locked_reqs = reqs
        ver_tuple = parse_stable_semver(vers)
        if ver_tuple is not None and ver_tuple > locked_tuple:
            newer_candidates.append((ver_tuple, vers, reqs))

    if not newer_candidates or locked_reqs is None:
        return False

    newer_candidates.sort(key=lambda item: item[0])
    updated_releases = [
        (vers, reqs)
        for _, vers, reqs in newer_candidates
        if reqs != locked_reqs
    ]
    if not updated_releases:
        return False

    latest_vers, latest_reqs = updated_releases[-1]
    changes = []
    for dep_name in tracked_deps:
        if latest_reqs[dep_name] != locked_reqs[dep_name]:
            old_disp = locked_reqs[dep_name] if locked_reqs[dep_name] is not None else "<none>"
            new_disp = latest_reqs[dep_name] if latest_reqs[dep_name] is not None else "<removed>"
            changes.append(f"{dep_name}: {old_disp} -> {new_disp}")
    print(
        f"Notification: A new version of {crate_name} ({latest_vers}, currently locked: {locked_ver}) "
        f"updates tracked dependencies ({'; '.join(changes)}).\n"
        f"Please update `Cargo.lock` (e.g. `cargo update -p {crate_name}`) and check "
        "whether RUSTSEC-2026-0543 (`chrono`) can now be removed from .cargo/audit.toml.",
        file=sys.stderr,
    )
    return True

iroh_changed = check_crate_updates("iroh", "https://index.crates.io/ir/oh/iroh", ["netwatch"])
netwatch_changed = check_crate_updates("netwatch", "https://index.crates.io/ne/tw/netwatch", ["chrono", "wmi"])
if iroh_changed or netwatch_changed:
    sys.exit(1)
PYEOF
    then
        echo "Commit stopped: chrono policy or iroh/netwatch dependency check failed. See notification above."
        exit 1
    fi
else
    echo "Warning: python3 not found; skipping crates.io iroh/netwatch update check."
fi

exit 0
