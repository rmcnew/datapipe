#!/bin/sh
#
# An example hook script to verify what is about to be committed.
# Called by "git commit" with no arguments.  The hook should
# exit with non-zero status after issuing an appropriate message if
# it wants to stop the commit.
#
# To enable this hook, rename this file to "pre-commit".

if git rev-parse --verify HEAD >/dev/null 2>&1
then
	against=HEAD
else
	# Initial commit: diff against an empty tree object
	against=$(git hash-object -t tree /dev/null)
fi

# If you want to allow non-ASCII filenames set this variable to true.
allownonascii=$(git config --type=bool hooks.allownonascii)

# Redirect output to stderr.
exec 1>&2

# Cross platform projects tend to avoid non-ASCII filenames; prevent
# them from being added to the repository. We exploit the fact that the
# printable range starts at the space character and ends with tilde.
if [ "$allownonascii" != "true" ] &&
	# Note that the use of brackets around a tr range is ok here, (it's
	# even required, for portability to Solaris 10's /usr/bin/tr), since
	# the square bracket bytes happen to fall in the designated range.
	test $(git diff --cached --name-only --diff-filter=A -z $against |
	  LC_ALL=C tr -d '[ -~]\0' | wc -c) != 0
then
	cat <<\EOF
Error: Attempt to add a non-ASCII file name.

This can cause problems if you want to work with people on other platforms.

To be portable it is advisable to rename the file.

If you know what you are doing you can disable this check using:

  git config hooks.allownonascii true
EOF
	exit 1
fi

# If there are whitespace errors, print the offending file names and fail.
#exec git diff-index --check --cached $against --

### Mandatory Rust project checks
# ensure code passes unit tests and integration tests
if ! cargo test 
then
    echo "Some tests are not passing.  Please fix and run 'cargo test' for more information."
    exit 1
fi

# ensure code passes clippy linter
if ! cargo clippy --locked --all-targets --all-features -- -D warnings 
then
    echo "There are some clippy linter issues.  Run 'cargo clippy --locked --all-targets --all-features -- -D warnings' for more information."
    exit 1
fi

# ensure code is properly formatted
if ! cargo fmt -- --check
then
    echo "There are some code formatting or style issues.  Run 'cargo fmt -- --check' for more information."
    exit 1
fi

# documentation builds without issues
if ! cargo doc --locked --no-deps --all-features
then
    echo "There are some documentation build issues.  Run 'cargo doc --locked --no-deps --all-features' for more information."
    exit 1
fi

# security audit dependencies (cargo audit)
if ! cargo audit
then
    echo "Security audit failed or vulnerabilities found in dependencies. Run 'cargo audit' for more information."
    exit 1
fi

# Check crates.io for a newer version of iroh that updates its netwatch dependency
# (used to track when transitive dependency paste / RUSTSEC-2024-0436 can be resolved)
if command -v python3 >/dev/null 2>&1; then
    if ! python3 - "$(git rev-parse --show-toplevel)/Cargo.lock" <<'PYEOF'
import json
import re
import sys
import urllib.error
import urllib.request

lock_path = sys.argv[1]
try:
    with open(lock_path, "r", encoding="utf-8") as fh:
        lock_text = fh.read()
except OSError as err:
    print(f"Warning: Could not read {lock_path} to check iroh/netwatch versions: {err}", file=sys.stderr)
    sys.exit(0)

pkg_versions = {}
for block in re.split(r"\n\[\[package\]\]\s*\n", lock_text):
    name_m = re.search(r'^name\s*=\s*"([^"]+)"', block, re.MULTILINE)
    ver_m = re.search(r'^version\s*=\s*"([^"]+)"', block, re.MULTILINE)
    if name_m and ver_m:
        pkg_versions.setdefault(name_m.group(1), []).append(ver_m.group(1))

iroh_versions = pkg_versions.get("iroh", [])
if not iroh_versions:
    sys.exit(0)

def parse_stable_semver(ver_str):
    core = ver_str.split("+", 1)[0]
    if "-" in core:
        return None
    parts = core.split(".")
    if len(parts) != 3 or not all(p.isdigit() for p in parts):
        return None
    return tuple(int(p) for p in parts)

locked_iroh = iroh_versions[0]
locked_iroh_tuple = parse_stable_semver(locked_iroh)
if locked_iroh_tuple is None:
    sys.exit(0)

locked_netwatch = ", ".join(pkg_versions.get("netwatch", ["unknown"]))

url = "https://index.crates.io/ir/oh/iroh"
req = urllib.request.Request(url, headers={"User-Agent": "datapipe-pre-commit-hook"})
try:
    with urllib.request.urlopen(req, timeout=10) as resp:
        index_lines = resp.read().decode("utf-8").splitlines()
except (urllib.error.URLError, TimeoutError, OSError) as err:
    print(f"Warning: Unable to query crates.io for iroh updates ({err}); skipping iroh/netwatch check.", file=sys.stderr)
    sys.exit(0)

def netwatch_req(entry):
    reqs = [
        d.get("req", "")
        for d in entry.get("deps", [])
        if d.get("name") == "netwatch" and d.get("kind", "normal") == "normal"
    ]
    return ", ".join(sorted(set(reqs))) if reqs else None

locked_netwatch_req = None
newer_candidates = []
for line in index_lines:
    line = line.strip()
    if not line:
        continue
    try:
        entry = json.loads(line)
    except json.JSONDecodeError:
        continue
    if entry.get("yanked"):
        continue
    vers = entry.get("vers", "")
    if vers == locked_iroh:
        locked_netwatch_req = netwatch_req(entry)
    ver_tuple = parse_stable_semver(vers)
    if ver_tuple is not None and ver_tuple > locked_iroh_tuple:
        newer_candidates.append((ver_tuple, vers, netwatch_req(entry)))

if not newer_candidates:
    sys.exit(0)

newer_candidates.sort(key=lambda item: item[0])
updated_releases = [
    (vers, nw_req)
    for _, vers, nw_req in newer_candidates
    if nw_req != locked_netwatch_req
]

if updated_releases:
    latest_vers, latest_nw_req = updated_releases[-1]
    old_req_display = locked_netwatch_req if locked_netwatch_req is not None else "<none>"
    new_req_display = latest_nw_req if latest_nw_req is not None else "<removed>"
    print(
        f"Notification: A new version of iroh ({latest_vers}, currently locked: {locked_iroh}) "
        f"updates the netwatch dependency from {old_req_display} (locked: {locked_netwatch}) "
        f"to {new_req_display}.\n"
        "Please update iroh in Cargo.toml / Cargo.lock (e.g. `cargo update -p iroh`) and check "
        "whether RUSTSEC-2024-0436 (`paste`) can now be removed from .cargo/audit.toml.",
        file=sys.stderr,
    )
    sys.exit(1)
PYEOF
    then
        echo "Commit stopped: a new iroh release updates netwatch. See notification above."
        exit 1
    fi
else
    echo "Warning: python3 not found; skipping crates.io iroh/netwatch update check."
fi

exit 0
